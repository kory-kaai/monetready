{
  "name": "monetready-cli",
  "version": "0.1.0",
  "description": "Monetready CLI - score, launch, and monetize your product",
  "license": "MIT",
  "type": "module",
  "bin": {
    "monetready": "./dist/index.js"
  },
  "main": "./dist/index.js",
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=20"
  },
  "repository": {
    "type": "git",
